generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrgStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MemberRole {
  OWNER
  ADMIN
  OPERATOR
  SUPPORT
  ANALYST
  VIEWER
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SiteStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LocationSource {
  GOOGLE_PLACES
  GOOGLE_GEOCODING
  MANUAL
  MANUAL_ADJUSTMENT
}

enum LocationValidationStatus {
  UNVALIDATED
  SUGGESTED
  CONFIRMED
  PARTIAL
  INVALID
}

// CAP-002 — charging core domain (M001-A-DEC-005: Site -> ChargingStation ->
// EVSE -> Connector). "Charger" is deliberately not a model here — it is
// retired as a persisted entity per the approved decision and survives only
// as commercial/UI terminology. See docs/domain/M001-A_OPEN_DECISIONS_v0.1.md
// and docs/domain/CAP-002_CHARGING_TERMINOLOGY_MAPPING.md.

// Administrative lifecycle only (mirrors SiteStatus) — NOT live operational
// state, which OCPP will own once that capability exists. A station can be
// ACTIVE administratively while individual EVSEs are OFFLINE operationally.
enum ChargingStationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Operational availability. Reused value set from the frontend's existing
// ChargerStatus (apps/movos-web/src/types/charger.ts) — the values already
// described EVSE-level operational state, just attached to the wrong tier
// before this decision. CAP-002 only ever writes AVAILABLE/UNAVAILABLE/
// OFFLINE via CRUD; CHARGING/OCCUPIED/RESERVED/FAULTED are reserved for the
// future OCPP capability and are not set by any code in this migration.
enum EvseStatus {
  AVAILABLE
  CHARGING
  OCCUPIED
  RESERVED
  UNAVAILABLE
  FAULTED
  OFFLINE
}

// Same value set as EvseStatus, kept as a distinct enum rather than shared —
// matches this schema's existing convention of one enum per entity even
// where values coincide (see UserStatus/OrgStatus/MemberStatus). Mirrors the
// frontend's existing ConnectorStatus (apps/movos-web/src/types/connector.ts)
// exactly.
enum ConnectorStatus {
  AVAILABLE
  CHARGING
  OCCUPIED
  RESERVED
  UNAVAILABLE
  FAULTED
  OFFLINE
}

// Reused as-is from the frontend's existing ConnectorType
// (apps/movos-web/src/types/connector.ts) — no divergence.
enum ConnectorType {
  CCS2
  TYPE2
  CHADEMO
}

enum CurrentType {
  AC
  DC
}

enum PhaseType {
  SINGLE_PHASE
  THREE_PHASE
}

// CAP-003 — OCPP engine foundation (WO-ARGOS-007). See
// docs/domain/CAP-003_OCPP_ARCHITECTURE_DECISIONS_v0.1.md and
// docs/domain/OCPP_PROTOCOL_COEXISTENCE_v0.1.md.

enum OcppProtocolVersion {
  OCPP1_6J
  OCPP2_0_1
}

enum OcppMessageDirection {
  INBOUND
  OUTBOUND
}

enum OcppMessageType {
  CALL
  CALLRESULT
  CALLERROR
}

// Distinct from ChargingStationStatus/EvseStatus/ConnectorStatus, which
// describe the *device*. This describes what the engine did with one
// specific protocol message.
enum OcppProcessingStatus {
  RECEIVED
  PROCESSED
  UNSUPPORTED
  REJECTED
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships     Membership[]
  refreshSessions RefreshSession[]
  auditEvents     AuditEvent[]     @relation("ActorAuditEvents")
  createdSites    Site[]
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships Membership[]
  sites       Site[]
  auditEvents AuditEvent[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole   @default(VIEWER)
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model Site {
  id              String     @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  city            String
  address         String
  latitude        Float?
  longitude       Float?
  status          SiteStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  createdByUserId String

  // Rich location fields — populated by Google or manual entry
  formattedAddress         String?
  addressLine1             String?
  addressLine2             String?
  state                    String?
  postalCode               String?
  countryCode              String?
  googlePlaceId            String?
  locationSource           LocationSource           @default(MANUAL)
  locationValidationStatus LocationValidationStatus @default(UNVALIDATED)
  locationValidatedAt      DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  createdBy        User              @relation(fields: [createdByUserId], references: [id])
  chargingStations ChargingStation[]

  @@unique([organizationId, slug])
}

// The complete physical charging device installed at a Site. May contain one
// or multiple independently controllable EVSEs. Organization scoping is
// derived through siteId -> Site.organizationId, not stored redundantly here
// — no query in CAP-002's API surface needs "all stations across an
// organization" directly; every list is already scoped by Site.
model ChargingStation {
  id             String                @id @default(cuid())
  siteId         String
  name           String
  code           String?
  manufacturer   String?
  model          String?
  serialNumber   String?
  // Free-form version string (e.g. "OCPP 1.6J"), matching the frontend's
  // existing Charger.ocppVersion precedent — deliberately not an enum; the
  // set of protocol versions is not this migration's to model prematurely.
  protocol       String?
  status         ChargingStationStatus @default(DRAFT)
  commissionedAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  // CAP-003 — OCPP network identity (CAP-003_OCPP_ARCHITECTURE_DECISIONS
  // Decision 1, ADR-0010). Globally unique (not scoped to siteId — this is
  // the value a physical device presents when it connects), never the
  // primary key, deliberately provisioned rather than derived from
  // code/serialNumber. Nullable until a station is actually provisioned for
  // OCPP; not every ChargingStation needs one immediately after CAP-002
  // creation.
  ocppIdentity String? @unique

  // MVP device authentication (Decision 2, ADR-0010): WSS + HTTP Basic Auth
  // with a strong per-station secret, hashed at rest — same discipline as
  // User.passwordHash. Never returned by any read endpoint. The plaintext
  // value exists only transiently at provisioning/rotation time, in the API
  // response of that one call, and is never persisted or logged.
  ocppSecretHash      String?
  ocppProvisionedAt   DateTime?
  ocppSecretRotatedAt DateTime?
  // Revocation is distinct from rotation: rotation replaces the secret and
  // keeps the station connectable; revocation (this field) marks a station
  // as explicitly disconnected/decommissioned without necessarily
  // reprovisioning a new secret immediately.
  ocppRevokedAt       DateTime?

  site               Site                @relation(fields: [siteId], references: [id])
  evses              Evse[]
  ocppProtocolEvents OcppProtocolEvent[]

  // Nullable-safe: Postgres treats multiple NULLs as distinct, so stations
  // without a business code never collide with each other.
  @@unique([siteId, code])
}

// An independently operable electric vehicle supply unit. Owns operational
// state, availability, electrical limits, and (in a future capability)
// charging-session relationships. No organizationId or siteId stored here —
// ownership is derived through chargingStationId -> Site -> Organization;
// every access check in CAP-002 walks that full chain.
model Evse {
  id                String @id @default(cuid())
  chargingStationId String

  // Protocol/hardware identifier (e.g. an OCPP 2.x evseId) — explicitly NOT
  // the primary key, and mutable, per the instruction not to use a hardware
  // or protocol identifier as the database key. Named externalId rather than
  // "evseId" to avoid a confusing stutter with the model's own name.
  externalId  String?
  name        String?
  status      EvseStatus   @default(UNAVAILABLE)
  maxPowerKw  Float?
  currentType CurrentType?
  phaseType   PhaseType?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  chargingStation ChargingStation @relation(fields: [chargingStationId], references: [id])
  connectors      Connector[]

  @@unique([chargingStationId, externalId])
}

// The physical interface through which a vehicle connects to an EVSE.
model Connector {
  id     String @id @default(cuid())
  evseId String

  // Protocol/hardware identifier (e.g. an OCPP connectorId) — not the
  // primary key, mutable. Same externalId naming rationale as Evse.
  externalId String?
  type       ConnectorType
  status     ConnectorStatus @default(UNAVAILABLE)
  maxPowerKw Float?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  evse Evse @relation(fields: [evseId], references: [id])

  @@unique([evseId, externalId])
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  subjectType    String?
  subjectId      String?
  metadata       Json?
  occurredAt     DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation("ActorAuditEvents", fields: [actorUserId], references: [id])
}

// CAP-003 — append-only raw OCPP protocol-event log (Decision 5, ADR-0011).
// Distinct from AuditEvent: AuditEvent records human-attributable domain
// mutations at ordinary CRUD frequency; this records every inbound/outbound
// protocol frame at device-message frequency, successfully processed or
// not, so unsupported-feature handling and malformed frames are auditable
// rather than a silent black hole (see OCPP_PROTOCOL_COEXISTENCE_v0.1.md).
// Never used to answer "what is the device's current status" — that's
// Evse.status/Connector.status; this is history, not current state.
//
// Retention policy (required by ARGOS's approval of Decision 5 — unlimited
// retention without a stated policy is explicitly forbidden): during the
// pilot phase, at pilot fleet volume, rows are retained indefinitely and no
// automatic purge is implemented by CAP-003. This is an explicit, stated
// interim policy, not silence — a scheduled purge/archival strategy MUST be
// designed before general-availability volume makes unbounded growth a
// real problem. See docs/engineering/OCPP_ENGINE_GUIDE.md.
model OcppProtocolEvent {
  id                String               @id @default(cuid())
  // Nullable: a connection that fails authentication, or a frame received
  // before the station's identity is resolved, still needs to be logged.
  chargingStationId String?
  protocolVersion   OcppProtocolVersion
  direction         OcppMessageDirection
  messageType       OcppMessageType
  // The OCPP action name (e.g. "BootNotification"). Null for a CALLRESULT/
  // CALLERROR, which carry no action of their own — see protocolMessageId.
  action            String?
  // OCPP's own message id (correlates a CALL to its CALLRESULT/CALLERROR).
  protocolMessageId String?
  // The raw frame payload. Adapters are responsible for never including a
  // secret here (the Basic Auth credential travels in the WS handshake
  // header, never inside an OCPP payload, so this is structural, not just a
  // scrubbing convention) — see docs/engineering/OCPP_ENGINE_GUIDE.md.
  payload           Json
  receivedAt        DateTime             @default(now())
  processingStatus  OcppProcessingStatus @default(RECEIVED)
  processingError   String?
  // Groups the frames belonging to one logical exchange (e.g. a CALL and
  // its eventual CALLRESULT) for easier debugging — distinct from
  // protocolMessageId, which is the protocol's own id and may be reused
  // across unrelated connections over time.
  correlationId     String?

  chargingStation ChargingStation? @relation(fields: [chargingStationId], references: [id])

  @@index([chargingStationId, receivedAt])
}
