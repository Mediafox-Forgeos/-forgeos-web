generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrgStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MemberRole {
  OWNER
  ADMIN
  OPERATOR
  SUPPORT
  ANALYST
  VIEWER
  // WO-ARGOS-037 — Technician Identity & My Work. A 7th real actor the role
  // vocabulary already anticipated (see docs/operations/OPERATIONAL_ACTORS.md),
  // scoped narrower than every other role: self-only visibility onto WorkOrder
  // (see MyWorkController), no access to any other route.
  TECHNICIAN
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SiteStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LocationSource {
  GOOGLE_PLACES
  GOOGLE_GEOCODING
  MANUAL
  MANUAL_ADJUSTMENT
}

enum LocationValidationStatus {
  UNVALIDATED
  SUGGESTED
  CONFIRMED
  PARTIAL
  INVALID
}

// CAP-002 — charging core domain (M001-A-DEC-005: Site -> ChargingStation ->
// EVSE -> Connector). "Charger" is deliberately not a model here — it is
// retired as a persisted entity per the approved decision and survives only
// as commercial/UI terminology. See docs/domain/M001-A_OPEN_DECISIONS_v0.1.md
// and docs/domain/CAP-002_CHARGING_TERMINOLOGY_MAPPING.md.

// Administrative lifecycle only (mirrors SiteStatus) — NOT live operational
// state, which OCPP will own once that capability exists. A station can be
// ACTIVE administratively while individual EVSEs are OFFLINE operationally.
enum ChargingStationStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Operational availability. Reused value set from the frontend's existing
// ChargerStatus (apps/movos-web/src/types/charger.ts) — the values already
// described EVSE-level operational state, just attached to the wrong tier
// before this decision. CAP-002 only ever writes AVAILABLE/UNAVAILABLE/
// OFFLINE via CRUD; CHARGING/OCCUPIED/RESERVED/FAULTED are reserved for the
// future OCPP capability and are not set by any code in this migration.
enum EvseStatus {
  AVAILABLE
  CHARGING
  OCCUPIED
  RESERVED
  UNAVAILABLE
  FAULTED
  OFFLINE
}

// Same value set as EvseStatus, kept as a distinct enum rather than shared —
// matches this schema's existing convention of one enum per entity even
// where values coincide (see UserStatus/OrgStatus/MemberStatus). Mirrors the
// frontend's existing ConnectorStatus (apps/movos-web/src/types/connector.ts)
// exactly.
enum ConnectorStatus {
  AVAILABLE
  CHARGING
  OCCUPIED
  RESERVED
  UNAVAILABLE
  FAULTED
  OFFLINE
}

// Reused as-is from the frontend's existing ConnectorType
// (apps/movos-web/src/types/connector.ts) — no divergence.
enum ConnectorType {
  CCS2
  TYPE2
  CHADEMO
}

enum CurrentType {
  AC
  DC
}

enum PhaseType {
  SINGLE_PHASE
  THREE_PHASE
}

// CAP-003 — OCPP engine foundation (WO-ARGOS-007). See
// docs/domain/CAP-003_OCPP_ARCHITECTURE_DECISIONS_v0.1.md and
// docs/domain/OCPP_PROTOCOL_COEXISTENCE_v0.1.md.

enum OcppProtocolVersion {
  OCPP1_6J
  OCPP2_0_1
}

// CAP-005 (WO-ARGOS-010) — device connectivity, deliberately distinct from
// ChargingStationStatus (administrative), EvseStatus/ConnectorStatus
// (operational), and ChargingSessionStatus (business). See
// docs/domain/CAP-005_CONNECTIVITY_ENGINE.md.
enum ConnectivityStatus {
  ONLINE
  OFFLINE
  UNKNOWN
}

enum OcppMessageDirection {
  INBOUND
  OUTBOUND
}

enum OcppMessageType {
  CALL
  CALLRESULT
  CALLERROR
}

// Distinct from ChargingStationStatus/EvseStatus/ConnectorStatus, which
// describe the *device*. This describes what the engine did with one
// specific protocol message.
enum OcppProcessingStatus {
  RECEIVED
  PROCESSED
  UNSUPPORTED
  REJECTED
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships     Membership[]
  refreshSessions RefreshSession[]
  auditEvents     AuditEvent[]     @relation("ActorAuditEvents")
  createdSites    Site[]

  // WO-ARGOS-026 — Operational Execution Layer.
  assignedActions Action[]

  // WO-ARGOS-035 — Work Order V1.
  assignedWorkOrders WorkOrder[]
  workOrderEvents    WorkOrderEvent[]
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  memberships Membership[]
  sites       Site[]
  auditEvents AuditEvent[]

  // CAP-004 — denormalized directly onto ChargingSession/AuthorizationAttempt
  // (see schema comment on ChargingSession) rather than derived through the
  // Site->ChargingStation chain the rest of this schema uses.
  chargingSessions         ChargingSession[]
  authorizationCredentials AuthorizationCredential[]
  authorizationAttempts    AuthorizationAttempt[]

  // CAP-009 — BillingAccount is tenant-scoped like every other business
  // record (never spans organizations, per DEC-022's tenant-isolation
  // precedent). TariffSnapshot is denormalized here too, deliberately not
  // always equal to the owning ChargingSession's organizationId — see the
  // roaming note on TariffSnapshot itself.
  billingAccounts BillingAccount[]
  tariffSnapshots TariffSnapshot[]

  // WO-ARGOS-026 — Operational Execution Layer.
  actions Action[]

  // WO-ARGOS-035 — Work Order V1.
  workOrders WorkOrder[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole   @default(VIEWER)
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model Site {
  id              String     @id @default(cuid())
  organizationId  String
  name            String
  slug            String
  city            String
  address         String
  latitude        Float?
  longitude       Float?
  status          SiteStatus @default(DRAFT)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  createdByUserId String

  // Rich location fields — populated by Google or manual entry
  formattedAddress         String?
  addressLine1             String?
  addressLine2             String?
  state                    String?
  postalCode               String?
  countryCode              String?
  googlePlaceId            String?
  locationSource           LocationSource           @default(MANUAL)
  locationValidationStatus LocationValidationStatus @default(UNVALIDATED)
  locationValidatedAt      DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id])
  createdBy        User              @relation(fields: [createdByUserId], references: [id])
  chargingStations ChargingStation[]

  // CAP-004 — see the ChargingSession model comment for why this is stored
  // directly rather than derived through chargingStations.
  chargingSessions ChargingSession[]

  @@unique([organizationId, slug])
}

// The complete physical charging device installed at a Site. May contain one
// or multiple independently controllable EVSEs. Organization scoping is
// derived through siteId -> Site.organizationId, not stored redundantly here
// — no query in CAP-002's API surface needs "all stations across an
// organization" directly; every list is already scoped by Site.
model ChargingStation {
  id             String                @id @default(cuid())
  siteId         String
  name           String
  code           String?
  manufacturer   String?
  model          String?
  serialNumber   String?
  // Free-form version string (e.g. "OCPP 1.6J"), matching the frontend's
  // existing Charger.ocppVersion precedent — deliberately not an enum; the
  // set of protocol versions is not this migration's to model prematurely.
  protocol       String?
  status         ChargingStationStatus @default(DRAFT)
  commissionedAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  // CAP-003 — OCPP network identity (CAP-003_OCPP_ARCHITECTURE_DECISIONS
  // Decision 1, ADR-0010). Globally unique (not scoped to siteId — this is
  // the value a physical device presents when it connects), never the
  // primary key, deliberately provisioned rather than derived from
  // code/serialNumber. Nullable until a station is actually provisioned for
  // OCPP; not every ChargingStation needs one immediately after CAP-002
  // creation.
  ocppIdentity String? @unique

  // MVP device authentication (Decision 2, ADR-0010): WSS + HTTP Basic Auth
  // with a strong per-station secret, hashed at rest — same discipline as
  // User.passwordHash. Never returned by any read endpoint. The plaintext
  // value exists only transiently at provisioning/rotation time, in the API
  // response of that one call, and is never persisted or logged.
  ocppSecretHash      String?
  ocppProvisionedAt   DateTime?
  ocppSecretRotatedAt DateTime?
  // Revocation is distinct from rotation: rotation replaces the secret and
  // keeps the station connectable; revocation (this field) marks a station
  // as explicitly disconnected/decommissioned without necessarily
  // reprovisioning a new secret immediately.
  ocppRevokedAt       DateTime?

  // CAP-005 (WO-ARGOS-010) — last-known connectivity evidence, distinct
  // from ChargingStationStatus (administrative) and from live connection
  // state (which stays in-memory in ConnectionRegistryService, never
  // persisted here — see docs/domain/CAP-005_CONNECTIVITY_ENGINE.md).
  // Deliberately NOT authoritative for "is this station connected right
  // now" — only for "what do we last know," including across a process
  // restart, where startup reconciliation forces ONLINE -> UNKNOWN rather
  // than trusting a value that predates the restart (see
  // docs/engineering/CONNECTIVITY_RUNTIME_GUIDE.md).
  connectivityStatus  ConnectivityStatus   @default(UNKNOWN)
  lastConnectedAt     DateTime?
  lastDisconnectedAt  DateTime?
  // Set alongside lastConnectedAt at connect/reconnect time — deliberately
  // NOT updated on every inbound OCPP message (that would mean a DB write
  // per Heartbeat/StatusNotification/MeterValues across the whole fleet,
  // exactly the write-amplification HeartbeatHandler's own doc comment
  // already argues against for CAP-003). ConnectionRegistryService's
  // in-memory lastMessageAt remains the fine-grained, per-message signal;
  // this field is the coarser, restart-surviving one. A known
  // simplification, not yet distinguishable from lastConnectedAt in this
  // version — see docs/domain/CAP-005_CONNECTIVITY_ENGINE.md's known
  // limitations.
  lastSeenAt          DateTime?
  lastProtocolVersion OcppProtocolVersion?

  site               Site                @relation(fields: [siteId], references: [id])
  evses              Evse[]
  ocppProtocolEvents OcppProtocolEvent[]

  // CAP-004
  chargingSessions      ChargingSession[]
  authorizationAttempts AuthorizationAttempt[]

  // WO-ARGOS-026 — Operational Execution Layer.
  actions Action[]

  // WO-ARGOS-035 — Work Order V1.
  workOrders WorkOrder[]

  // Nullable-safe: Postgres treats multiple NULLs as distinct, so stations
  // without a business code never collide with each other.
  @@unique([siteId, code])
}

// An independently operable electric vehicle supply unit. Owns operational
// state, availability, electrical limits, and (in a future capability)
// charging-session relationships. No organizationId or siteId stored here —
// ownership is derived through chargingStationId -> Site -> Organization;
// every access check in CAP-002 walks that full chain.
model Evse {
  id                String @id @default(cuid())
  chargingStationId String

  // Protocol/hardware identifier (e.g. an OCPP 2.x evseId) — explicitly NOT
  // the primary key, and mutable, per the instruction not to use a hardware
  // or protocol identifier as the database key. Named externalId rather than
  // "evseId" to avoid a confusing stutter with the model's own name.
  externalId  String?
  name        String?
  status      EvseStatus   @default(UNAVAILABLE)
  maxPowerKw  Float?
  currentType CurrentType?
  phaseType   PhaseType?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  chargingStation ChargingStation @relation(fields: [chargingStationId], references: [id])
  connectors      Connector[]

  // CAP-004
  chargingSessions      ChargingSession[]
  authorizationAttempts AuthorizationAttempt[]

  @@unique([chargingStationId, externalId])
}

// The physical interface through which a vehicle connects to an EVSE.
model Connector {
  id     String @id @default(cuid())
  evseId String

  // Protocol/hardware identifier (e.g. an OCPP connectorId) — not the
  // primary key, mutable. Same externalId naming rationale as Evse.
  externalId String?
  type       ConnectorType
  status     ConnectorStatus @default(UNAVAILABLE)
  maxPowerKw Float?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  evse Evse @relation(fields: [evseId], references: [id])

  // CAP-004
  chargingSessions      ChargingSession[]
  authorizationAttempts AuthorizationAttempt[]

  @@unique([evseId, externalId])
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  user User @relation(fields: [userId], references: [id])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  subjectType    String?
  subjectId      String?
  metadata       Json?
  occurredAt     DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User?         @relation("ActorAuditEvents", fields: [actorUserId], references: [id])
}

// CAP-003 — append-only raw OCPP protocol-event log (Decision 5, ADR-0011).
// Distinct from AuditEvent: AuditEvent records human-attributable domain
// mutations at ordinary CRUD frequency; this records every inbound/outbound
// protocol frame at device-message frequency, successfully processed or
// not, so unsupported-feature handling and malformed frames are auditable
// rather than a silent black hole (see OCPP_PROTOCOL_COEXISTENCE_v0.1.md).
// Never used to answer "what is the device's current status" — that's
// Evse.status/Connector.status; this is history, not current state.
//
// Retention policy (required by ARGOS's approval of Decision 5 — unlimited
// retention without a stated policy is explicitly forbidden): during the
// pilot phase, at pilot fleet volume, rows are retained indefinitely and no
// automatic purge is implemented by CAP-003. This is an explicit, stated
// interim policy, not silence — a scheduled purge/archival strategy MUST be
// designed before general-availability volume makes unbounded growth a
// real problem. See docs/engineering/OCPP_ENGINE_GUIDE.md.
model OcppProtocolEvent {
  id                String               @id @default(cuid())
  // Nullable: a connection that fails authentication, or a frame received
  // before the station's identity is resolved, still needs to be logged.
  chargingStationId String?
  protocolVersion   OcppProtocolVersion
  direction         OcppMessageDirection
  messageType       OcppMessageType
  // The OCPP action name (e.g. "BootNotification"). Null for a CALLRESULT/
  // CALLERROR, which carry no action of their own — see protocolMessageId.
  action            String?
  // OCPP's own message id (correlates a CALL to its CALLRESULT/CALLERROR).
  protocolMessageId String?
  // The raw frame payload. Adapters are responsible for never including a
  // secret here (the Basic Auth credential travels in the WS handshake
  // header, never inside an OCPP payload, so this is structural, not just a
  // scrubbing convention) — see docs/engineering/OCPP_ENGINE_GUIDE.md.
  payload           Json
  receivedAt        DateTime             @default(now())
  processingStatus  OcppProcessingStatus @default(RECEIVED)
  processingError   String?
  // Groups the frames belonging to one logical exchange (e.g. a CALL and
  // its eventual CALLRESULT) for easier debugging — distinct from
  // protocolMessageId, which is the protocol's own id and may be reused
  // across unrelated connections over time.
  correlationId     String?

  chargingStation ChargingStation? @relation(fields: [chargingStationId], references: [id])

  @@index([chargingStationId, receivedAt])
}

// ============================================================================
// CAP-004 — Charging Sessions & Authorization Foundation (WO-ARGOS-009)
// See docs/domain/CAP-004_CHARGING_SESSIONS_FOUNDATION.md for the full
// design (ownership model, session-creation boundary, termination model,
// energy model, lifecycle, OCPP mapping). Builds on CAP-003 without
// modifying it — no field on ChargingStation/Evse/Connector/
// OcppProtocolEvent above is touched by this section.
// ============================================================================

enum AuthCredentialType {
  RFID
  QR
  APP
  REMOTE
  API
  FLEET
  PLUG_AND_CHARGE
  GUEST
}

enum AuthCredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
  BLOCKED
}

enum AuthAttemptResult {
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
  UNKNOWN
  OFFLINE_ACCEPTED
}

enum ChargingSessionStatus {
  PENDING
  AUTHORIZED
  STARTING
  ACTIVE
  SUSPENDED
  OFFLINE
  STOPPING
  COMPLETED
  FAILED
  CANCELLED
}

enum ChargingSessionTerminationReason {
  NORMAL_COMPLETION
  CABLE_DISCONNECTED
  VEHICLE_FULL
  REMOTE_STOP
  EMERGENCY_STOP
  FAULT
  TIMEOUT
  POWER_LOSS
  STATION_REBOOT
  USER_CANCELLED
  NETWORK_FAILURE
  UNKNOWN
}

// The single abstraction every authorization method is an instance of — a
// physical RFID card, an app-issued token, a QR payload, an API key, a
// fleet account reference, or a future Plug & Charge certificate. See
// docs/domain/MOVOS_AUTHORIZATION_ARCHITECTURE_v0.1.md for the full
// conceptual design this model implements.
model AuthorizationCredential {
  id                 String               @id @default(cuid())
  organizationId     String
  type               AuthCredentialType
  // The physical/protocol-facing identifier (e.g. an RFID UID, normalized
  // to uppercase hex with no separators before storage) — deliberately
  // never the primary key, same discipline as Evse.externalId/
  // Connector.externalId. Unique per organization, not globally: two
  // different organizations may each issue a card that happens to produce
  // the same raw UID on a specific reader/vendor combination.
  externalIdentifier String
  status             AuthCredentialStatus @default(ACTIVE)
  issuedAt           DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  // Type-specific data (e.g. a friendly label, issuing fleet reference).
  // Never used to store secrets — this credential type is not itself a
  // secret (see MOVOS_AUTHORIZATION_ARCHITECTURE_v0.1.md's RFID section).
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id])
  chargingSessions      ChargingSession[]
  authorizationAttempts AuthorizationAttempt[]

  @@unique([organizationId, externalIdentifier])
}

// One record per presentation of a credential at a station — stored
// unconditionally, whether the outcome was ACCEPTED or not (a rejected
// attempt is itself operationally meaningful). Created both for a
// standalone OCPP Authorize message and, again, as part of resolving the
// idTag carried on a StartTransaction — see CAP-004_CHARGING_SESSIONS_
// FOUNDATION.md §5/§8 for why the same model serves both call sites.
model AuthorizationAttempt {
  id             String @id @default(cuid())
  organizationId String

  chargingStationId String
  evseId            String?
  connectorId       String?

  authorizationCredentialId String?

  // The raw identifier as presented (e.g. the OCPP idTag string), captured
  // even when it resolves to no known AuthorizationCredential (result =
  // UNKNOWN) — without this, an UNKNOWN attempt would record that
  // *something* was presented but not *what*, defeating the point of an
  // append-only audit trail. Not part of the WO's literal field list;
  // added because "every authorization attempt must be stored" requires
  // enough information to reconstruct what happened.
  presentedIdentifier String

  attemptedAt DateTime          @default(now())
  result      AuthAttemptResult
  reason      String?

  organization            Organization             @relation(fields: [organizationId], references: [id])
  chargingStation         ChargingStation          @relation(fields: [chargingStationId], references: [id])
  evse                    Evse?                    @relation(fields: [evseId], references: [id])
  connector               Connector?               @relation(fields: [connectorId], references: [id])
  authorizationCredential AuthorizationCredential? @relation(fields: [authorizationCredentialId], references: [id])

  @@index([chargingStationId, attemptedAt])
  @@index([authorizationCredentialId])
}

// A business-domain charging session — see CAP-004_CHARGING_SESSIONS_
// FOUNDATION.md for the full design. Ownership fields (organizationId,
// siteId, chargingStationId, evseId, connectorId) are stored directly
// here, a deliberate exception to the Evse/Connector "derive through the
// parent chain" pattern used elsewhere in this schema — see §2 of that
// document for why this table specifically denormalizes.
model ChargingSession {
  id             String @id @default(cuid())
  organizationId String
  siteId         String

  chargingStationId String
  evseId            String
  connectorId       String

  authorizationCredentialId String

  // CAP-009 (WO-ARGOS-017A) — required, per the approved invariant "every
  // ChargingSession has exactly one BillingAccount" (Objective 1, Option
  // A). Originally nullable (WO-ARGOS-017); hardened here after ARGOS
  // review found that mismatched the approved invariant. Every
  // pre-existing session was backfilled with a per-organization
  // SYSTEM_DEFAULT BillingAccount before this column became NOT NULL — see
  // the migration and docs/domain/CAP-009_BILLING_ACCOUNT_MODEL.md's
  // "System/default account" section. A debtor *reference* remains an
  // ownership fact, not a price or invoice field — the same reasoning that
  // justified this column's existence in the first place (CAP-004 §16,
  // DEC-018) is unaffected by the nullable-to-required change.
  billingAccountId String

  protocolVersion       OcppProtocolVersion
  // MOVOS-assigned (1.6J) or device-assigned (2.0.1, not implemented)
  // transaction identifier — see §5's "Where protocolTransactionId comes
  // from". Unique per station, not globally: two different stations may
  // legitimately mint the same-looking transaction id from independent
  // sequences.
  protocolTransactionId String

  status            ChargingSessionStatus             @default(PENDING)
  terminationReason ChargingSessionTerminationReason?

  // Raw device-reported cumulative meter readings, not MOVOS-computed
  // deltas — meterStart is known at creation (StartTransaction always
  // carries it), meterStop only once the session ends.
  meterStart Int
  meterStop  Int?
  // The accumulated total — always resolvable without any MeterValue rows
  // existing (DEC-016). Starts at 0, updated as data arrives, finalized as
  // meterStop - meterStart at termination.
  energyWh   Int  @default(0)

  // Immutable once set — see the lifecycle engine's enforcement, not just
  // this comment; no service method accepts startedAt as an update param.
  startedAt DateTime
  // Null until the session reaches a terminal state; a session cannot
  // terminate twice (lifecycle engine refuses to re-terminate a row whose
  // endedAt is already non-null).
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization            Organization            @relation(fields: [organizationId], references: [id])
  site                    Site                    @relation(fields: [siteId], references: [id])
  chargingStation         ChargingStation         @relation(fields: [chargingStationId], references: [id])
  evse                    Evse                    @relation(fields: [evseId], references: [id])
  connector               Connector               @relation(fields: [connectorId], references: [id])
  authorizationCredential AuthorizationCredential @relation(fields: [authorizationCredentialId], references: [id])
  meterValues             MeterValue[]
  tariffSnapshots         TariffSnapshot[]

  // CAP-009 (WO-ARGOS-017A) — a composite FK, deliberately, not a plain
  // [billingAccountId] -> [id] reference. Pairing organizationId alongside
  // billingAccountId means Postgres itself rejects any attempt to assign a
  // BillingAccount belonging to a *different* organization than the
  // session's own — a real tenant-isolation gap the original, single-column
  // FK left open (nothing prevented a cross-tenant assignment at the
  // database level). References BillingAccount's [organizationId, id]
  // unique constraint, below. onDelete: Restrict — see
  // docs/domain/CAP-009_ARCHIVAL_POLICY.md for why SET NULL (the original,
  // Prisma-default behavior) was replaced.
  billingAccount BillingAccount @relation(fields: [organizationId, billingAccountId], references: [organizationId, id], onDelete: Restrict)

  // "protocolTransactionId is unique per charging station" (WO rule) plus
  // the idempotency requirement in §13: a retransmitted StartTransaction
  // for a transaction MOVOS already has a session for must be detectable
  // as a duplicate via this exact constraint, not a race-prone read-then-
  // write check.
  @@unique([chargingStationId, protocolTransactionId])
  @@index([organizationId, status])
  @@index([siteId, status])
}

// Periodic telemetry during an active session (OCPP MeterValues /
// TransactionEvent(Updated)) — optional, append-only, never a dependency
// of ChargingSession's own correctness (DEC-016). No update/delete is
// exposed by MeterValuesService; rows are write-once.
model MeterValue {
  id        String   @id @default(cuid())
  sessionId String
  timestamp DateTime
  energyWh  Int

  powerW      Int?
  voltage     Float?
  current     Float?
  frequency   Float?
  temperature Float?

  createdAt DateTime @default(now())

  session ChargingSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, timestamp])
}

// CAP-009 (WO-ARGOS-017) — materializes the canonical-debt-owner decision
// from CAP-008 (docs/domain/CAP-008_DEBT_OWNERSHIP.md). The party
// responsible for paying for a ChargingSession, deliberately decoupled
// from the operational facts of how the session happened (which
// credential authorized it, which vehicle/driver used it — see CAP-008's
// rejection of AuthorizationCredential/Vehicle/Driver/Fleet as the
// canonical owner). Deliberately minimal: no address, payment method, tax
// information, or invoice field — those belong to future capabilities
// (Architecture Backlog #25/#26), not this foundation.
enum BillingAccountType {
  INDIVIDUAL
  COMPANY
  FLEET
  HOA_CONDOMINIUM
  ROAMING_PARTNER
  // CAP-009 (WO-ARGOS-017A) — the placeholder account type the backfill
  // migration creates, one per organization, to satisfy "every
  // ChargingSession has exactly one BillingAccount" for sessions that
  // predate this concept entirely. Never created by ordinary application
  // flow. See docs/domain/CAP-009_BILLING_ACCOUNT_MODEL.md.
  SYSTEM_DEFAULT
}

// Deliberately two values, not the ACTIVE/INACTIVE/ARCHIVED pattern used
// elsewhere (e.g. OrgStatus) — CAP-009's own invariants (see
// docs/domain/CAP-009_INVARIANTS.md) only ever discuss "archived, never
// deleted." A third state was not invented without a named business
// reason for it to exist.
enum BillingAccountStatus {
  ACTIVE
  ARCHIVED
}

model BillingAccount {
  id             String               @id @default(cuid())
  organizationId String
  type           BillingAccountType
  displayName    String
  status         BillingAccountStatus @default(ACTIVE)
  // ISO 4217 currency code (e.g. "USD", "COP"). Plain String, not an enum
  // — enumerating every ISO 4217 code in the schema is impractical, and no
  // Currency concept exists anywhere else in this codebase to reuse.
  // Validation belongs to the future service implementation, not this
  // foundation (see docs/domain/CAP-009_BILLING_ACCOUNT_MODEL.md).
  currency  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  chargingSessions ChargingSession[]

  // No natural-key @@unique constraint: evaluated and deliberately not
  // added — see docs/domain/CAP-009_BILLING_ACCOUNT_MODEL.md's
  // "Uniqueness constraints" section for why no natural key exists at
  // this deliberately minimal field set. That finding is unchanged.
  //
  // The @@unique below is a *structural* constraint, not a natural-key
  // one: it exists purely so ChargingSession's composite tenant-isolation
  // foreign key (see ChargingSession.billingAccount) has a matching
  // target to reference. `id` alone is already unique (it's the primary
  // key) — this adds organizationId alongside it so Postgres can enforce
  // "the referenced BillingAccount belongs to the same organization as
  // the referencing ChargingSession" declaratively, with no trigger.
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

// CAP-009 (WO-ARGOS-017) — materializes CAP-008_DECISION.md's tariff-timing
// choice (Option C: a snapshot captured at session start and again at each
// pricing-relevant boundary crossed, degenerating to a single snapshot for
// a session that crosses none). Immutable and append-only by convention:
// deliberately no `updatedAt` field, and no update/delete method exists on
// TariffSnapshotService's interface (see
// apps/movos-api/src/billing/tariff-snapshot.service.interface.ts) — see
// docs/domain/CAP-009_TARIFF_SNAPSHOT_MODEL.md for why this is an
// application-level guarantee, not a database trigger, in this foundation.
model TariffSnapshot {
  id                String @id @default(cuid())
  chargingSessionId String
  // Denormalized, deliberately not always equal to
  // ChargingSession.organizationId — DEC-018's roaming case means a
  // session may be priced from a different organization's tariff than the
  // one operating the station. See
  // docs/domain/CAP-009_TARIFF_SNAPSHOT_MODEL.md.
  organizationId String

  // All three price components are frozen at capture time — never
  // recomputed, never looked up live. Decimal, never Float: these are
  // money values (see docs/domain/CAP-009_TARIFF_SNAPSHOT_MODEL.md for the
  // precision rationale).
  energyPricePerKwh Decimal @db.Decimal(12, 6)
  pricePerMinute    Decimal @db.Decimal(12, 6)
  fixedFee          Decimal @db.Decimal(12, 2)
  // ISO 4217 currency code — must match every other TariffSnapshot for the
  // same ChargingSession (CAP-009_INVARIANTS.md's "session currency never
  // changes" rule), enforced at the service layer, not by a database
  // constraint, in this foundation.
  currency String
  // IANA timezone name (e.g. "America/Bogota") — the timezone this
  // snapshot's rate schedule (day/night, peak/off-peak) is defined
  // against, independent of the database server's own timezone.
  timezone String
  // The moment this snapshot's terms began applying — a business fact,
  // distinct from createdAt (when the row was physically written, which
  // could differ if a snapshot is ever backfilled).
  effectiveAt DateTime

  createdAt DateTime @default(now())

  chargingSession ChargingSession @relation(fields: [chargingSessionId], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id])

  @@index([chargingSessionId, effectiveAt])
}

// ============================================================================
// WO-ARGOS-026 — Operational Execution Layer. The minimal persistence layer
// the Operational Intelligence MVP (WO-ARGOS-025) was explicitly built
// without — see docs/implementation/OPERATIONAL_INTELLIGENCE_TECHNICAL_
// NOTES.md's "no acknowledge/dismiss action" limitation and
// docs/product/RECOMMENDATION_STRATEGY.md's recommendation that any action
// surface here stay smaller than Incident's four-stage lifecycle. This is
// deliberately not Alert/Incident/MaintenanceTicket (CAP-X_INCIDENT_FLOW.md)
// — a distinct, narrower entity scoped only to RecommendationService's
// output, not to raw device/connectivity faults. See
// docs/implementation/OPERATIONAL_EXECUTION_LAYER_TECHNICAL_NOTES.md.
// ============================================================================

// Mirrors packages/shared-types/src/movos-api.ts's RecommendationType and
// RecommendationSeverity exactly — the same 5 recommendation types and 2
// severities the Operational Intelligence MVP already computes. Kept as
// real Prisma enums (not a plain String) for the same reason every other
// fixed, small, real-domain value set in this schema is a Prisma enum, not
// because this WO grows the recommendation catalog itself — it doesn't.
enum RecommendationType {
  ENERGY_ANOMALY
  AUTH_FAILURE_SPIKE
  IDLE_CONNECTOR
  COMPARATIVE_UNDERPERFORMANCE
  EFFICIENCY_DRIFT
}

// Uppercase, matching every other status enum in this schema
// (ChargingSessionStatus, ConnectivityStatus, etc.) — the Operational
// Intelligence MVP's own ApiRecommendation.severity shipped as lowercase
// 'high'/'medium', the one inconsistency with this API's own established
// vocabulary convention (docs/product/OPERATIONAL_VOCABULARY.md,
// WO-ARGOS-023). Corrected here rather than compounded: this enum is
// authoritative, and RecommendationService/the frontend were updated to
// match it, not the other way around.
enum RecommendationSeverity {
  HIGH
  MEDIUM
}

// Objective 3's five states. Note this is 5 states behind 5 operator
// actions, not 4 — Objective 1 named acknowledge/assign/snooze/resolve,
// but DISMISSED (Objective 3) has no reachable trigger among those four.
// A `dismiss` action was added to close that gap — see
// OPERATIONAL_EXECUTION_LAYER_TECHNICAL_NOTES.md's "the fifth action" note.
// `OPEN` is never actually written to a row by this implementation — see
// the same document's "why OPEN is never persisted" note; kept in the enum
// for schema completeness and any future explicit-reopen action.
enum ActionStatus {
  OPEN
  ACKNOWLEDGED
  ASSIGNED
  RESOLVED
  DISMISSED
}

// The lightweight Action Center's one entity. Created only on an operator's
// first real interaction with a still-live, still-computed recommendation
// — never pre-created for every recommendation RecommendationService
// returns, which would turn every dashboard load into a write. Snapshots
// the recommendation's content (title/severity/explanation/evidence/
// recommendedAction) at that moment, per Objective 5 — explainability must
// survive even after the live condition clears and RecommendationService
// stops returning it.
model Action {
  id                 String             @id @default(cuid())
  organizationId     String
  chargingStationId  String
  recommendationType RecommendationType

  // Snapshot, immutable after creation — the exact recommendation an
  // operator saw and acted on, not a live reference that could drift.
  title             String
  severity          RecommendationSeverity
  explanation       String
  evidence          Json
  recommendedAction String

  status           ActionStatus @default(OPEN)
  assignedToUserId String?
  // Set by the `snooze` action — suppresses this Action from the "pending"
  // grouping until the timestamp passes, without inventing a 6th status.
  snoozedUntil     DateTime?
  // Holds the operator's own words at whichever terminal transition
  // happened — resolution notes for RESOLVED, a reason for DISMISSED.
  // One field, not two, since exactly one of the two terminal states can
  // ever apply to a given row.
  notes            String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  organization    Organization    @relation(fields: [organizationId], references: [id])
  chargingStation ChargingStation @relation(fields: [chargingStationId], references: [id])
  assignedTo      User?           @relation(fields: [assignedToUserId], references: [id])

  @@index([organizationId, status])
  @@index([chargingStationId, recommendationType])
}

// ============================================================================
// WO-ARGOS-035 — Work Order V1. The first execution layer that coordinates a
// person, not just a chargers's status, around an operational problem —
// scoped per docs/operations/WORKORDER_READINESS.md's own recommendation
// (WO-ARGOS-034) to exactly the three sources with a complete, evidenced
// actor chain: CONNECTIVITY_LOSS, RECOMMENDATION, MANUAL. CUSTOMER_REPORT
// and MAINTENANCE are deliberately excluded from this version — their
// upstream actors (Customer Support, scheduled-maintenance detection) have
// no real product surface yet, per docs/operations/RESPONSIBILITY_MATRIX.md.
// No Technician entity here either (docs/operations/TECHNICIAN_MODEL.md was
// designed, not authorized for this implementation) — assignment in V1 is
// to a real User, the same actor Action.assignedToUserId already uses.
// ============================================================================

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

// No CRITICAL-vs-HIGH distinction is enforced anywhere yet — see the open
// question docs/operations/WORK_ORDER_AUTOMATIONS.md Rule 2 already named
// (RecommendationSeverity has no CRITICAL tier). CRITICAL exists here as a
// real, selectable value an operator can choose; nothing currently derives
// it automatically.
enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Deliberately 3 values, not the 5 docs/operations/WORK_ORDER_DOMAIN.md
// designed — CUSTOMER_REPORT and MAINTENANCE excluded per this work order's
// explicit scope restriction, not an oversight.
enum WorkOrderSource {
  CONNECTIVITY_LOSS
  RECOMMENDATION
  MANUAL
}

enum WorkOrderEventType {
  CREATED
  ASSIGNED
  STARTED
  COMMENTED
  RESOLVED
  CANCELLED
  // WO-ARGOS-037 — field checklist (docs/operations/WORK_ORDER_CHECKLISTS.md).
  // Reuses WorkOrderEvent.payload for stage-specific evidence; zero new tables.
  ARRIVAL_CONFIRMED
  DIAGNOSIS_RECORDED
  INTERVENTION_RECORDED
  VALIDATION_RECORDED
}

// The V1 entity — a deliberately smaller field set than
// docs/operations/WORK_ORDER_DOMAIN.md's own proposal (no connectorId,
// incidentId, dueAt, slaMinutes, or evidence in this version). Every
// omitted field is a real, separately-scoped future capability, not a
// forgotten one.
model WorkOrder {
  id          String @id @default(cuid())
  title       String
  description String

  status   WorkOrderStatus   @default(OPEN)
  priority WorkOrderPriority
  source   WorkOrderSource

  organizationId String
  stationId      String

  assignedMemberId String?
  assignedAt       DateTime?
  startedAt        DateTime?
  resolvedAt       DateTime?

  // Current-value note, mirroring Action.notes — the full comment history
  // lives in WorkOrderEvent (type: COMMENTED), not duplicated here.
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  station        ChargingStation @relation(fields: [stationId], references: [id])
  assignedMember User?           @relation(fields: [assignedMemberId], references: [id])
  events         WorkOrderEvent[]

  @@index([organizationId, status])
  @@index([stationId])
}

// Append-only event log — the history log Action never got (see
// docs/product/LEARNING_SIGNALS.md signal 5). One row per real change;
// `payload` carries whatever structured detail that event type needs (a
// comment's text, a cancellation reason) rather than a fixed column per
// event type — deliberately loose, the same reasoning
// AuthorizationCredential.metadata already established for this schema.
model WorkOrderEvent {
  id          String             @id @default(cuid())
  workOrderId String
  type        WorkOrderEventType
  actorId     String?
  payload     Json?

  createdAt DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  actor     User?     @relation(fields: [actorId], references: [id])

  @@index([workOrderId, createdAt])
}
