# Hey Foxy — variables de entorno (sin valores reales; nunca commitear secretos)
# Sin SUPABASE_URL la app arranca en MODO DEMOSTRACIÓN con datos ficticios.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Proveedor IA (abstracción multi-proveedor). heuristic = sin red, sin costo.
HF_AI_PROVIDER=heuristic
HF_AI_MODEL=
OPENAI_API_KEY=

# Conectores: deshabilitados hasta Gate de credenciales (Metricool/Meta/WhatsApp).
HF_CONNECTOR_METRICOOL_ENABLED=false
HF_CONNECTOR_META_ENABLED=false
HF_CONNECTOR_YOUTUBE_ENABLED=false

# WhatsApp: solo "simulate" en QA. "live" requiere aprobación explícita.
HF_WHATSAPP_MODE=simulate

# Clave maestra para cifrado de credenciales (AES-256-GCM, base64 32 bytes).
HF_CREDENTIALS_KEK=
