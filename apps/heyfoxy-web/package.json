{
  "name": "@mediafox/heyfoxy-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build && node scripts/check-trace.mjs",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "format": "prettier --write .",
